# HOSTINGER PRODUCTION ENVIRONMENT
NODE_ENV=production
PORT=3000
APP_URL=https://your-domain.com
CLIENT_URL=https://your-domain.com

# Hostinger MySQL - replace with values from hPanel > Databases > MySQL Databases
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_sitecontrol
DB_USER=u123456789_sitecontrol
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_SSL=false

JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=12h
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20
